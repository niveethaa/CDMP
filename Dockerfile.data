FROM node:22-bookworm

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 \
  && rm -rf /var/lib/apt/lists/*

COPY server/package*.json ./server/
RUN cd server && npm ci

COPY server ./server
COPY pcrf_normalization/normalize_pcfrf.py ./pcrf_normalization/normalize_pcfrf.py

WORKDIR /app/server

CMD ["npm", "run", "check:data"]
